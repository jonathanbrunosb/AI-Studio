# Sprint 2 — configure only on the server/environment; never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Sprint 5 — geração de imagens (fal.ai). Somente no servidor; nunca usar prefixo NEXT_PUBLIC_.
AI_IMAGE_PROVIDER=fal
FAL_KEY=
# Sprint 7 — assinatura dos pacotes de publicação (ECDSA P-256, PKCS#8 PEM; use \n para quebras de linha).
# Gerar: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
PORTAL_SIGNING_PRIVATE_KEY=
