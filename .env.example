# AI Studio — variáveis de ambiente. NUNCA registre valores reais neste arquivo nem no repositório.
# Em Railway, cadastre cada variável no ambiente correspondente (homologação/produção).
# Detalhes, responsáveis e rotação: docs/DEPLOYMENT.md.

# --- Supabase (obrigatórias) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor. Ignora RLS: nunca expor ao navegador nem registrar em logs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação (obrigatórias em homologação/produção) ---------------------------
# URL pública HTTPS (sem barra final). Usada em redirecionamentos e links de redefinição de senha.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Chave estável para criptografia das Server Actions (32 bytes em base64: openssl rand -base64 32).
# Obrigatória com mais de uma réplica ou entre deploys para não invalidar formulários abertos.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# HSTS: ativar ("true") SOMENTE em produção com HTTPS validado no domínio e subdomínios.
ENABLE_HSTS=false

# --- Geração de imagens com IA (opcional; sem chave a IA fica indisponível) -----
AI_IMAGE_PROVIDER=fal
FAL_KEY=

# --- Integração com o Portal (opcional) ------------------------------------------
# ECDSA P-256 em PKCS#8 PEM, com \n no lugar das quebras de linha.
# Gerar: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
PORTAL_SIGNING_PRIVATE_KEY=

# --- Somente testes E2E locais (NUNCA definir em Railway) -------------------------
# E2E_MODE=true habilita o simulador da fal.ai em loopback; é ignorado quando há variáveis do Railway.
# E2E_MODE=
# E2E_FAL_BASE_URL=
